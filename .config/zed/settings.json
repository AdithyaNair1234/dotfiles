// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.

{
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "audio": {
    "experimental.legacy_audio_compatible": true,
    "experimental.rodio_audio": true
  },
  "base_keymap": "VSCode",
  "disable_ai": false,
  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle"
  },
  "tab_bar": {
    "show": true
  },
  "show_edit_predictions": false,
  "indent_guides": {
    "enabled": true,
    "coloring": "fixed"
  },
  "agent": {
    "tool_permissions": {
      "default": "allow"
    },
    "dock": "right",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5"
    },
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5"
    },
    "model_parameters": []
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-language-server", "eslint", "pi-probe"]
    },
    "TSX": {
      "language_servers": ["typescript-language-server", "eslint", "pi-probe"]
    },
    "JavaScript": {
      "language_servers": ["typescript-language-server", "eslint", "pi-probe"]
    },
    "JSX": {
      "language_servers": ["typescript-language-server", "eslint", "pi-probe"]
    },
    "Python": {
      "language_servers": ["ruff", "ty", "pi-probe"],
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    },
    "Haskell": {
      "language_servers": ["haskell-language-server", "pi-probe"]
    },
    "Markdown": {
      "language_servers": ["marksman", "pi-probe"]
    },
    "Rust": {
      "language_servers": ["rust-analyzer", "pi-probe"]
    },
    "Go": {
      "language_servers": ["gopls", "pi-probe"]
    },
    "C": {
      "language_servers": ["clangd", "pi-probe"]
    },
    "C++": {
      "language_servers": ["clangd", "pi-probe"]
    },
    "Ruby": {
      "language_servers": ["solargraph", "pi-probe"]
    }
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": false
  },
  "vim_mode": true,
  "active_pane_modifiers": {
    "border_size": 1
  },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 80,
          "lint": {
            "extendSelect": ["I"]
          }
        }
      }
    },
    "pi-probe": {
      "binary": {
        "path": "/usr/bin/node",
        "arguments": ["/home/adithya/projects/pi-probe/lsp-server.mjs"]
      },
      "env": {
        "UNDERSTANDING_FILE": "/home/adithya/projects/pi-probe/function-understanding.jsonl"
      },
      "languages": ["TypeScript", "TSX", "JavaScript", "JSX", "Haskell", "Markdown", "Rust", "Python", "Go", "C", "C++", "Ruby"]
    }
  },
  "relative_line_numbers": "enabled",
  "project_panel": {
    "dock": "left",
    "entry_spacing": "standard"
  },
  "ui_font_size": 15,
  "scrollbar": {
    "show": "never"
  },
  "buffer_font_size": 14,
  "buffer_font_family": "IosevkaTermSlab Nerd Font",
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark Hard"
  }
}
